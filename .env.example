# Copie para .env (não versionado) e preencha os segredos.
# O .env é carregado apenas quando APP_PROFILE=development.
# As receitas `just prod-*` NÃO leem este arquivo; use o shell ou APP_ENV_FILE.

APP_PROFILE=development

# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
APP__JWT__SECRET=

APP__DATABASE__URL=postgres://app:app@localhost:55432/app
APP__REDIS__URL=redis://localhost:56379

# Só habilite atrás de um proxy que define X-Real-IP ou acrescenta o cliente
# no fim do X-Forwarded-For.
APP__SERVER__TRUST_PROXY_HEADERS=false

# Rate limit (padrões abaixo).
APP__RATE_LIMIT__LOGIN_ACCOUNT_ATTEMPTS=5
APP__RATE_LIMIT__LOGIN_IP_ATTEMPTS=20
APP__RATE_LIMIT__LOGIN_WINDOW_SECS=900
APP__RATE_LIMIT__PASSWORD_RESET_ACCOUNT_ATTEMPTS=3
APP__RATE_LIMIT__PASSWORD_RESET_IP_ATTEMPTS=10
APP__RATE_LIMIT__VERIFICATION_ACCOUNT_ATTEMPTS=3
APP__RATE_LIMIT__VERIFICATION_IP_ATTEMPTS=10

# Exige e-mail confirmado para entrar (precisa de SMTP funcionando).
APP__SECURITY__REQUIRE_EMAIL_VERIFIED=false
# HSTS em segundos; 0 desliga. Só faz efeito em HTTPS.
APP__SECURITY__HSTS_MAX_AGE_SECS=0
# Cookie de sessão: Secure em produção (HTTPS); dev local usa false.
# APP__SECURITY__COOKIE_SECURE=false
# strict, lax ou none; none exige Secure e front em outro site.
# APP__SECURITY__COOKIE_SAME_SITE=strict

# Expõe /docs e /api-docs/openapi.json. Desligue em produção pública.
APP__DOCS__ENABLED=true

# Métricas: token opcional (mín. 16 caracteres); vazio deixa /metrics público.
APP__METRICS__ENABLED=true
APP__METRICS__TOKEN=

# Retenção do audit_log em dias; 0 mantém para sempre.
APP__AUDIT__RETENTION_DAYS=365

# E-mail local com Mailpit (just mail-up): recebe tudo em http://localhost:8025.
# Descomente para ver o e-mail de verdade no ambiente de desenvolvimento.
# APP__MAIL__PROVIDER=smtp
# APP__MAIL__SMTP_URL=smtp://127.0.0.1:1025
# APP__MAIL__FROM=nao-responda@teste.local
# Portas do Mailpit no host (evita colisão com outro projeto).
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# E-mail: em desenvolvimento use provider=log (só registra no console).
APP__MAIL__PROVIDER=log
APP__MAIL__FROM=nao-responda@example.com
# Para envio real, descomente e configure (a senha fica só no ambiente):
# APP__MAIL__PROVIDER=smtp
# APP__MAIL__SMTP_URL=smtps://usuario:senha@smtp.example.com:465

# Portas do host usadas pelo compose local (evita colisão entre projetos).
POSTGRES_PORT=55432
REDIS_PORT=56379

# --- Front no compose de deploy (perfil front) ---
# Imagem publicada pelo CI do repositório do front; em deploy automático o
# servidor só faz pull. Publicação no loopback: o nginx do host roteia /api.
# FRONT_IMAGE=ghcr.io/org/front:latest
# FRONT_PORT=3010
# API_PORT=8080
# Build local (docker/compose.front-build.yml): caminho do repositório do front
# e VITE_* embutidas no bundle.
# FRONT_CONTEXT=../react-vite-template
# VITE_API_URL=https://app.exemplo.com/api/v1
# VITE_AUTH_URL=/api/v1

RUST_LOG=info,template_backend_rust=debug
